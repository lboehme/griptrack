# Copy to .env and fill in for a real deployment. Never commit .env.

# Marks this as a production run: enables Secure/HTTPS-only session cookies
# and makes a missing session secret a hard startup error.
GRIPTRACK_ENV=production

# REQUIRED in production. Sign the session cookie with a long random secret.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GRIPTRACK_SESSION_SECRET=

# Where the SQLite file lives. Point this at a PERSISTENT, backed-up volume —
# not the ephemeral container filesystem, or you lose all data on redeploy.
GRIPTRACK_DATABASE_URL=sqlite:////data/griptrack.db

# STRONGLY RECOMMENDED for a public deploy. When set, the very first
# registration (the one that becomes admin) must supply this as its invite
# code. Closes the window where a stranger could claim admin before you
# register. Pick any long random string; delete it after you've registered.
GRIPTRACK_BOOTSTRAP_TOKEN=

# --- Continuous off-box backup via Litestream ---------------------------
# STRONGLY RECOMMENDED in production. When GRIPTRACK_REPLICA_BUCKET is set,
# the container replicates the SQLite file to S3-compatible object storage
# continuously and auto-restores it onto a fresh/empty volume on boot.
# Leave all of these unset to run without replication (local dev).
# Endpoint/region below show the Oracle Object Storage form — any
# S3-compatible provider works (see docs/deployment.md).
#GRIPTRACK_REPLICA_BUCKET=griptrack-backup
#GRIPTRACK_REPLICA_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#GRIPTRACK_REPLICA_REGION=<region>
#LITESTREAM_ACCESS_KEY_ID=
#LITESTREAM_SECRET_ACCESS_KEY=
