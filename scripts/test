#!/bin/sh
# Run the test suite. Uses the griptrack conda env when present (local dev);
# falls back to pytest on PATH (CI). Pass any pytest args through, e.g.:
#   scripts/test tests/test_names.py -q
set -e
cd "$(dirname "$0")/.."
if command -v conda >/dev/null 2>&1 && conda env list 2>/dev/null | grep -q "^griptrack "; then
    exec conda run --no-capture-output -n griptrack pytest "$@"
fi
exec pytest "$@"
