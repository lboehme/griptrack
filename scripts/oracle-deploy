#!/bin/sh
# Deploy to an Oracle Always Free Tier VM (prepared once with
# deploy/oracle/setup-server) and prove it came up — the Oracle counterpart
# of scripts/deploy. Ships the committed tree (git archive HEAD), builds on
# the VM, then requires a healthy https://<domain>/health and shows the
# entrypoint's migration/backup log lines.
#   scripts/oracle-deploy ubuntu@<vm-ip>       (or an SSH-config alias,
#                                               or set GRIPTRACK_ORACLE_HOST)
set -e
cd "$(dirname "$0")/.."

HOST="${1:-$GRIPTRACK_ORACLE_HOST}"
[ -n "$HOST" ] || { echo "usage: scripts/oracle-deploy <ssh-target>   (e.g. ubuntu@1.2.3.4)" >&2; exit 1; }

COMPOSE="docker compose -f deploy/oracle/compose.yaml --env-file /opt/griptrack/.env"

# Only committed work ships (git archive reads HEAD, not the working tree).
if [ -n "$(git status --porcelain)" ]; then
    echo "NOTE: uncommitted changes will NOT be deployed (shipping HEAD)."
fi
if ! git diff --quiet HEAD origin/main 2>/dev/null; then
    echo "WARNING: HEAD content differs from origin/main — deploying it anyway."
fi

echo "--- shipping source (git archive HEAD) ---"
git archive HEAD | ssh "$HOST" '
    set -e
    rm -rf /opt/griptrack/src
    mkdir -p /opt/griptrack/src
    tar -x -C /opt/griptrack/src
'

echo "--- building and starting containers on the VM ---"
ssh "$HOST" "set -e; cd /opt/griptrack/src && $COMPOSE up -d --build"

DOMAIN=$(ssh "$HOST" "sed -n 's/^GRIPTRACK_DOMAIN=//p' /opt/griptrack/.env")
[ -n "$DOMAIN" ] || { echo "deploy verification FAILED: no GRIPTRACK_DOMAIN in /opt/griptrack/.env" >&2; exit 1; }

echo "--- health check (https://${DOMAIN}/health) ---"
# First deploy needs a beat for Caddy to obtain the certificate; retry
# for up to ~90s before declaring failure.
attempt=0
code=000
while [ $attempt -lt 18 ]; do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://${DOMAIN}/health" || true)
    [ "$code" = "200" ] && break
    attempt=$((attempt + 1))
    sleep 5
done
echo "GET /health -> $code"
[ "$code" = "200" ] || { echo "deploy verification FAILED: /health returned $code" >&2; exit 1; }
curl -s --max-time 30 "https://${DOMAIN}/health" | grep -q "ok" \
    || { echo "deploy verification FAILED: /health did not report ok" >&2; exit 1; }

echo "--- entrypoint log (migration + backup) ---"
ssh "$HOST" "cd /opt/griptrack/src && $COMPOSE logs --no-log-prefix app" \
    | grep -E "\[entrypoint\]|Running upgrade|ERROR" | tail -10 || true
echo "deploy verified"
